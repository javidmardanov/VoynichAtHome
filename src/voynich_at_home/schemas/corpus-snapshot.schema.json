{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voynichathome.org/contracts/v1/corpus-snapshot.schema.json",
  "title": "Voynich@Home corpus snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_id",
    "title",
    "created_at",
    "sources",
    "transformations",
    "views"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "snapshot_id": {"$ref": "#/$defs/id"},
    "title": {"type": "string", "minLength": 1, "maxLength": 240},
    "created_at": {"type": "string", "format": "date-time"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/source"}
    },
    "transformations": {
      "type": "array",
      "items": {"$ref": "#/$defs/transformation"}
    },
    "views": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/view"}
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{2,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "role",
        "title",
        "version",
        "uri",
        "retrieved_at",
        "media_type",
        "bytes",
        "sha256",
        "attribution",
        "rights"
      ],
      "properties": {
        "source_id": {"$ref": "#/$defs/id"},
        "role": {"type": "string", "minLength": 1, "maxLength": 80},
        "title": {"type": "string", "minLength": 1, "maxLength": 240},
        "version": {"type": "string", "minLength": 1, "maxLength": 120},
        "uri": {"type": "string", "format": "uri"},
        "retrieved_at": {"type": "string", "format": "date-time"},
        "media_type": {"type": "string", "pattern": "^[a-z0-9.+-]+/[a-zA-Z0-9.+-]+$"},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"},
        "attribution": {"type": "string", "minLength": 1, "maxLength": 500},
        "rights": {"$ref": "#/$defs/rights"}
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "license_expression", "terms_uri", "distribution", "reviewed_at"],
      "properties": {
        "status": {
          "enum": ["cleared", "declared", "review-required", "restricted"]
        },
        "license_expression": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 120
        },
        "terms_uri": {
          "type": ["string", "null"],
          "format": "uri"
        },
        "distribution": {
          "enum": ["allowed", "allowed-with-notice", "metadata-only", "prohibited"]
        },
        "reviewed_at": {"type": "string", "format": "date-time"},
        "note": {"type": "string", "minLength": 1, "maxLength": 1000}
      }
    },
    "transformation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transformation_id", "tool", "inputs", "parameters", "output"],
      "properties": {
        "transformation_id": {"$ref": "#/$defs/id"},
        "tool": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version", "source_digest"],
          "properties": {
            "name": {"type": "string", "minLength": 1, "maxLength": 120},
            "version": {"type": "string", "minLength": 1, "maxLength": 80},
            "source_digest": {"$ref": "#/$defs/digest"}
          }
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/id"}
        },
        "parameters": {"$ref": "#/$defs/parameters"},
        "output": {"$ref": "#/$defs/artifact"}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "media_type", "bytes", "sha256"],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/id"},
        "media_type": {"type": "string", "pattern": "^[a-z0-9.+-]+/[a-zA-Z0-9.+-]+$"},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "view_id",
        "input_artifact_ids",
        "transcription_policy",
        "segmentation_policy",
        "uncertainty_policy",
        "normalization_policy",
        "artifact_sha256"
      ],
      "properties": {
        "view_id": {"$ref": "#/$defs/id"},
        "input_artifact_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/id"}
        },
        "transcription_policy": {"type": "string", "minLength": 1, "maxLength": 500},
        "segmentation_policy": {"type": "string", "minLength": 1, "maxLength": 500},
        "uncertainty_policy": {"type": "string", "minLength": 1, "maxLength": 500},
        "normalization_policy": {"type": "string", "minLength": 1, "maxLength": 500},
        "artifact_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "parameters": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]{0,63}$"},
      "additionalProperties": {
        "type": ["string", "integer", "boolean", "null"]
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
