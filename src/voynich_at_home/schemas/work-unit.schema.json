{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voynichathome.org/contracts/v1/work-unit.schema.json",
  "title": "Voynich@Home work unit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "work_unit_id",
    "experiment_digest",
    "compiler",
    "sequence",
    "partition",
    "worker",
    "inputs",
    "parameters",
    "randomness",
    "numeric_profile",
    "resources",
    "checkpoint",
    "output_contract"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "work_unit_id": {"$ref": "#/$defs/digest"},
    "experiment_digest": {"$ref": "#/$defs/digest"},
    "compiler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "source_digest"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 120},
        "version": {"type": "string", "minLength": 1, "maxLength": 80},
        "source_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "sequence": {"type": "integer", "minimum": 0},
    "partition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "group_ids", "control_id"],
      "properties": {
        "role": {"enum": ["discovery", "validation", "confirmation", "control"]},
        "group_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/id"}
        },
        "control_id": {
          "oneOf": [
            {"$ref": "#/$defs/id"},
            {"type": "null"}
          ]
        }
      }
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_digest", "entrypoint", "application_profile"],
      "properties": {
        "artifact_digest": {"$ref": "#/$defs/digest"},
        "entrypoint": {"type": "string", "minLength": 1, "maxLength": 240},
        "application_profile": {"type": "string", "minLength": 1, "maxLength": 120}
      }
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/artifact"}
    },
    "parameters": {"$ref": "#/$defs/parameters"},
    "randomness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "seed_hex", "stream_id"],
      "properties": {
        "algorithm": {"type": "string", "minLength": 1, "maxLength": 120},
        "seed_hex": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "stream_id": {"type": "integer", "minimum": 0}
      }
    },
    "numeric_profile": {"type": "string", "minLength": 1, "maxLength": 240},
    "resources": {"$ref": "#/$defs/resource_limits"},
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "interval_seconds", "schema_digest"],
      "properties": {
        "enabled": {"type": "boolean"},
        "interval_seconds": {"type": "integer", "minimum": 1},
        "schema_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "output_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_digest", "logical_name", "media_type"],
      "properties": {
        "schema_digest": {"$ref": "#/$defs/digest"},
        "logical_name": {"$ref": "#/$defs/id"},
        "media_type": {"type": "string", "pattern": "^[a-z0-9.+-]+/[a-zA-Z0-9.+-]+$"}
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{2,127}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "relative_path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$",
      "maxLength": 240
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "logical_name", "relative_path", "media_type", "bytes", "sha256"],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/id"},
        "logical_name": {"$ref": "#/$defs/id"},
        "relative_path": {"$ref": "#/$defs/relative_path"},
        "media_type": {"type": "string", "pattern": "^[a-z0-9.+-]+/[a-zA-Z0-9.+-]+$"},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "parameters": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]{0,63}$"},
      "additionalProperties": {
        "oneOf": [
          {"type": "string", "maxLength": 1000},
          {"type": "integer"},
          {"type": "boolean"},
          {"type": "null"},
          {
            "type": "array",
            "maxItems": 1000,
            "items": {"type": ["string", "integer", "boolean", "null"]}
          }
        ]
      }
    },
    "resource_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu_seconds", "memory_bytes", "disk_bytes", "output_bytes", "wall_seconds"],
      "properties": {
        "cpu_seconds": {"type": "integer", "minimum": 1},
        "memory_bytes": {"type": "integer", "minimum": 1048576},
        "disk_bytes": {"type": "integer", "minimum": 0},
        "output_bytes": {"type": "integer", "minimum": 1},
        "wall_seconds": {"type": "integer", "minimum": 1}
      }
    }
  }
}
