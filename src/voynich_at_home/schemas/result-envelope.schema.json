{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voynichathome.org/contracts/v1/result-envelope.schema.json",
  "title": "Voynich@Home untrusted result envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "result_id",
    "work_unit_id",
    "experiment_digest",
    "attempt",
    "worker_artifact_digest",
    "host_profile",
    "started_at",
    "finished_at",
    "status",
    "input_digests",
    "output",
    "telemetry",
    "checkpoint_restarts",
    "error"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "result_id": {"$ref": "#/$defs/id"},
    "work_unit_id": {"$ref": "#/$defs/digest"},
    "experiment_digest": {"$ref": "#/$defs/digest"},
    "attempt": {"type": "integer", "minimum": 1},
    "worker_artifact_digest": {"$ref": "#/$defs/digest"},
    "host_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runner_adapter", "platform", "architecture", "accelerator_class", "numeric_profile"],
      "properties": {
        "runner_adapter": {"enum": ["local", "ci", "trusted-oci", "boinc"]},
        "platform": {"type": "string", "minLength": 1, "maxLength": 80},
        "architecture": {"type": "string", "minLength": 1, "maxLength": 80},
        "accelerator_class": {"type": "string", "minLength": 1, "maxLength": 120},
        "numeric_profile": {"type": "string", "minLength": 1, "maxLength": 240}
      }
    },
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["success", "failed", "timeout", "cancelled"]},
    "input_digests": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/digest"}
    },
    "output": {
      "oneOf": [
        {"$ref": "#/$defs/output"},
        {"type": "null"}
      ]
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wall_milliseconds", "cpu_milliseconds", "peak_memory_bytes", "bytes_read", "bytes_written"],
      "properties": {
        "wall_milliseconds": {"type": "integer", "minimum": 0},
        "cpu_milliseconds": {"type": "integer", "minimum": 0},
        "peak_memory_bytes": {"type": "integer", "minimum": 0},
        "bytes_read": {"type": "integer", "minimum": 0},
        "bytes_written": {"type": "integer", "minimum": 0}
      }
    },
    "checkpoint_restarts": {"type": "integer", "minimum": 0},
    "error": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": {"type": "string", "minLength": 1, "maxLength": 80},
            "message": {"type": "string", "minLength": 1, "maxLength": 1000}
          }
        },
        {"type": "null"}
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "success"}}, "required": ["status"]},
      "then": {
        "properties": {
          "output": {"$ref": "#/$defs/output"},
          "error": {"type": "null"}
        }
      },
      "else": {
        "properties": {
          "output": {"type": "null"},
          "error": {"type": "object"}
        }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{2,127}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logical_name", "media_type", "bytes", "sha256", "summary"],
      "properties": {
        "logical_name": {"$ref": "#/$defs/id"},
        "media_type": {"type": "string", "pattern": "^[a-z0-9.+-]+/[a-zA-Z0-9.+-]+$"},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "summary": {
          "type": "object",
          "maxProperties": 100,
          "propertyNames": {"pattern": "^[a-z][a-z0-9_]{0,63}$"},
          "additionalProperties": {"type": ["string", "integer", "boolean", "null"]}
        }
      }
    }
  }
}
