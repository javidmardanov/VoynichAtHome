{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Toy Caesar worker output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "best_key",
    "best_score",
    "candidates_evaluated",
    "score_unit"
  ],
  "properties": {
    "best_key": {"type": "integer", "minimum": 0, "maximum": 25},
    "best_score": {"type": "integer", "minimum": -1, "maximum": 25},
    "candidates_evaluated": {"type": "integer", "minimum": 1, "maximum": 26},
    "score_unit": {"const": "matching_codepoints"}
  }
}
