{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "const": "vah-search-result-1"
    },
    "job_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "algorithm": {
      "type": "string",
      "enum": [
        "beam-v1",
        "restart-anneal-v1"
      ]
    },
    "key": {
      "minItems": 2,
      "maxItems": 92,
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 22
      }
    },
    "plaintext": {
      "type": "string",
      "minLength": 4,
      "maxLength": 20000,
      "pattern": "^[abcdefghilmnopqrstuvxyz]+$"
    },
    "score": {
      "type": "integer",
      "minimum": -20000000000,
      "maximum": 0
    },
    "evaluations": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000
    },
    "trace": {
      "maxItems": 1000,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    },
    "result_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "required": [
    "version",
    "job_digest",
    "algorithm",
    "key",
    "plaintext",
    "score",
    "evaluations",
    "trace",
    "result_digest"
  ],
  "additionalProperties": false,
  "$id": "urn:voynich:contracts:v1:search-result",
  "x-semantic-validation": "See platform/src/lib/contracts.ts and the Rust kernel; schema alone does not establish valid identities, scores, or execution."
}
