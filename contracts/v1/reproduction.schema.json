{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "const": "vah-reproduction-1"
    },
    "unit_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "work": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "const": "vah-work-1"
        },
        "type": {
          "type": "string",
          "enum": [
            "generation",
            "search",
            "verification"
          ]
        },
        "experiment_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "input_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "algorithm": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,100}$"
        },
        "numeric_profile": {
          "type": "string",
          "enum": [
            "wasm32-ieee754-libm-scalar-v1",
            "integer-ngram-libm-v1"
          ]
        },
        "release_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,100}$"
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "budget": {
          "type": "object",
          "properties": {
            "evaluations": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            },
            "max_input_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8000000
            },
            "max_memory_bytes": {
              "type": "integer",
              "minimum": 1048576,
              "maximum": 100663296
            }
          },
          "required": [
            "evaluations",
            "max_input_bytes",
            "max_memory_bytes"
          ],
          "additionalProperties": false
        },
        "work_estimate": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000000
        }
      },
      "required": [
        "version",
        "type",
        "experiment_digest",
        "input_digest",
        "algorithm",
        "numeric_profile",
        "release_id",
        "seed",
        "start",
        "budget",
        "work_estimate"
      ],
      "additionalProperties": false
    },
    "job": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "const": "vah-search-1"
        },
        "experiment": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "ciphertext": {
          "minItems": 4,
          "maxItems": 20000,
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 91
          }
        },
        "symbol_count": {
          "type": "integer",
          "minimum": 2,
          "maximum": 92
        },
        "encoding": {
          "type": "string",
          "enum": [
            "substitution",
            "homophonic",
            "balanced-homophonic"
          ]
        },
        "algorithm": {
          "type": "string",
          "enum": [
            "beam-v1",
            "restart-anneal-v1"
          ]
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "iterations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "beam_width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "model": {
          "type": "object",
          "properties": {
            "version": {
              "type": "string",
              "const": "vah-ngram-1"
            },
            "alphabet": {
              "type": "string",
              "const": "abcdefghilmnopqrstuvxyz"
            },
            "training_sources": {
              "minItems": 1,
              "maxItems": 100,
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            },
            "quadgrams": {
              "minItems": 279841,
              "maxItems": 279841,
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": -1000000,
                "maximum": 0
              }
            },
            "unigrams": {
              "minItems": 23,
              "maxItems": 23,
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": -1000000,
                "maximum": 0
              }
            }
          },
          "required": [
            "version",
            "alphabet",
            "training_sources",
            "quadgrams",
            "unigrams"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "version",
        "experiment",
        "ciphertext",
        "symbol_count",
        "encoding",
        "algorithm",
        "seed",
        "start",
        "iterations",
        "beam_width",
        "model"
      ],
      "additionalProperties": false
    },
    "result": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "version": {
              "type": "string",
              "const": "vah-search-result-1"
            },
            "job_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "algorithm": {
              "type": "string",
              "enum": [
                "beam-v1",
                "restart-anneal-v1"
              ]
            },
            "key": {
              "minItems": 2,
              "maxItems": 92,
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 22
              }
            },
            "plaintext": {
              "type": "string",
              "minLength": 4,
              "maxLength": 20000,
              "pattern": "^[abcdefghilmnopqrstuvxyz]+$"
            },
            "score": {
              "type": "integer",
              "minimum": -20000000000,
              "maximum": 0
            },
            "evaluations": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000
            },
            "trace": {
              "maxItems": 1000,
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            },
            "result_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "required": [
            "version",
            "job_digest",
            "algorithm",
            "key",
            "plaintext",
            "score",
            "evaluations",
            "trace",
            "result_digest"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "result_hash": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "state": {
      "type": "string",
      "enum": [
        "importing",
        "open",
        "checking",
        "validation_error",
        "delivery_exhausted",
        "complete"
      ]
    },
    "release": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,100}$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "url": {
          "type": "string",
          "pattern": "^\\/kernels\\/[0-9a-f]{64}\\.wasm$"
        },
        "state": {
          "type": "string",
          "enum": [
            "approved",
            "revoked"
          ]
        }
      },
      "required": [
        "id",
        "digest",
        "url",
        "state"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "unit_id",
    "work",
    "job",
    "result",
    "result_hash",
    "state",
    "release"
  ],
  "additionalProperties": false,
  "$id": "urn:voynich:contracts:v1:reproduction",
  "x-semantic-validation": "See platform/src/lib/contracts.ts and the Rust kernel; schema alone does not establish valid identities, scores, or execution."
}
