{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "const": "vah-scientific-report-1"
    },
    "campaign_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "title": {
      "type": "string",
      "minLength": 5,
      "maxLength": 120
    },
    "tier": {
      "type": "string",
      "enum": [
        "computation",
        "candidate",
        "conclusion"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 30,
      "maxLength": 3000
    },
    "limitations": {
      "minItems": 1,
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 10,
        "maxLength": 1000
      }
    },
    "evidence_url": {
      "type": "string",
      "maxLength": 1000,
      "format": "uri",
      "pattern": "^https:\\/\\/.*"
    },
    "record_ids": {
      "minItems": 1,
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    },
    "comparison_assessment": {
      "type": "string",
      "minLength": 30,
      "maxLength": 3000
    },
    "reviews": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "external-reproduction",
              "specialist"
            ]
          },
          "record_url": {
            "type": "string",
            "maxLength": 1000,
            "format": "uri",
            "pattern": "^https:\\/\\/.*"
          }
        },
        "required": [
          "name",
          "role",
          "record_url"
        ],
        "additionalProperties": false
      }
    },
    "recovery_scope": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "encoding": {
            "type": "string",
            "enum": [
              "substitution",
              "balanced-homophonic",
              "naibbe-global-permutation"
            ]
          },
          "symbol_count": {
            "type": "integer",
            "minimum": 2,
            "maximum": 92
          },
          "language": {
            "type": "string",
            "enum": [
              "latin",
              "italian"
            ]
          },
          "length": {
            "anyOf": [
              {
                "type": "number",
                "const": 1000
              },
              {
                "type": "number",
                "const": 5000
              },
              {
                "type": "number",
                "const": 20000
              }
            ]
          },
          "starts": {
            "anyOf": [
              {
                "type": "number",
                "const": 1
              },
              {
                "type": "number",
                "const": 8
              },
              {
                "type": "number",
                "const": 64
              }
            ]
          },
          "iterations": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000
          },
          "algorithm": {
            "type": "string",
            "enum": [
              "beam-v1",
              "restart-anneal-v1"
            ]
          },
          "beam_width": {
            "type": "integer",
            "minimum": 1,
            "maximum": 64
          },
          "model_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "cases": {
            "type": "number",
            "const": 100
          },
          "exact_recoveries": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "evaluation_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "freeze_url": {
            "type": "string",
            "maxLength": 1000,
            "format": "uri",
            "pattern": "^https:\\/\\/.*"
          },
          "usefulness_rationale": {
            "type": "string",
            "minLength": 40,
            "maxLength": 2000
          }
        },
        "required": [
          "encoding",
          "symbol_count",
          "language",
          "length",
          "starts",
          "iterations",
          "algorithm",
          "beam_width",
          "model_digest",
          "cases",
          "exact_recoveries",
          "evaluation_digest",
          "freeze_url",
          "usefulness_rationale"
        ],
        "additionalProperties": false
      }
    },
    "owner_attests_evidence_reviewed": {
      "type": "boolean",
      "const": true
    }
  },
  "required": [
    "version",
    "campaign_digest",
    "title",
    "tier",
    "summary",
    "limitations",
    "evidence_url",
    "record_ids",
    "comparison_assessment",
    "reviews",
    "recovery_scope",
    "owner_attests_evidence_reviewed"
  ],
  "additionalProperties": false,
  "$id": "urn:voynich:contracts:v1:scientific-report",
  "x-semantic-validation": "See platform/src/lib/contracts.ts and the Rust kernel; schema alone does not establish valid identities, scores, or execution."
}
