{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "const": "vah-campaign-1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{1,100}$"
    },
    "title": {
      "type": "string",
      "minLength": 5,
      "maxLength": 120
    },
    "question": {
      "type": "string",
      "minLength": 10,
      "maxLength": 500
    },
    "kind": {
      "type": "string",
      "enum": [
        "recovery",
        "generator-test",
        "manuscript"
      ]
    },
    "protocol_url": {
      "type": "string",
      "format": "uri"
    },
    "source_digests": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    },
    "methods": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9_-]{1,100}$"
      }
    },
    "metric": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "comparisons": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "stopping_rule": {
      "type": "string",
      "minLength": 10,
      "maxLength": 500
    },
    "exposure": {
      "type": "string",
      "minLength": 10,
      "maxLength": 1000
    },
    "recovery_evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    },
    "max_units": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "interpretation": {
      "type": "string",
      "minLength": 10,
      "maxLength": 1000
    },
    "search_condition": {
      "type": "object",
      "properties": {
        "encoding": {
          "type": "string",
          "enum": [
            "substitution",
            "balanced-homophonic",
            "naibbe-global-permutation"
          ]
        },
        "symbol_count": {
          "type": "integer",
          "minimum": 2,
          "maximum": 92
        },
        "language": {
          "type": "string",
          "enum": [
            "latin",
            "italian"
          ]
        },
        "length": {
          "anyOf": [
            {
              "type": "number",
              "const": 1000
            },
            {
              "type": "number",
              "const": 5000
            },
            {
              "type": "number",
              "const": 20000
            }
          ]
        },
        "starts": {
          "anyOf": [
            {
              "type": "number",
              "const": 1
            },
            {
              "type": "number",
              "const": 8
            },
            {
              "type": "number",
              "const": 64
            }
          ]
        },
        "iterations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "algorithm": {
          "type": "string",
          "enum": [
            "beam-v1",
            "restart-anneal-v1"
          ]
        },
        "beam_width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "model_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "encoding",
        "symbol_count",
        "language",
        "length",
        "starts",
        "iterations",
        "algorithm",
        "beam_width",
        "model_digest"
      ],
      "additionalProperties": false
    },
    "manuscript_layout": {
      "type": "object",
      "properties": {
        "transcription_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "ciphertext_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "symbol_grouping": {
          "type": "string",
          "minLength": 10,
          "maxLength": 1000
        },
        "space_handling": {
          "type": "string",
          "minLength": 5,
          "maxLength": 1000
        },
        "lines": {
          "minItems": 1,
          "maxItems": 2000,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "folio": {
                "type": "string",
                "minLength": 1,
                "maxLength": 30
              },
              "paragraph": {
                "type": "string",
                "minLength": 1,
                "maxLength": 50
              },
              "line": {
                "type": "string",
                "minLength": 1,
                "maxLength": 50
              },
              "offset": {
                "type": "integer",
                "minimum": 0,
                "maximum": 19999
              },
              "length": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20000
              },
              "uncertain_positions": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 19999
                }
              }
            },
            "required": [
              "folio",
              "paragraph",
              "line",
              "offset",
              "length",
              "uncertain_positions"
            ],
            "additionalProperties": false
          }
        },
        "excluded_material": {
          "maxItems": 1000,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      },
      "required": [
        "transcription_digest",
        "ciphertext_digest",
        "symbol_grouping",
        "space_handling",
        "lines",
        "excluded_material"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "id",
    "title",
    "question",
    "kind",
    "protocol_url",
    "source_digests",
    "methods",
    "metric",
    "comparisons",
    "stopping_rule",
    "exposure",
    "recovery_evidence",
    "max_units",
    "interpretation"
  ],
  "additionalProperties": false,
  "$id": "urn:voynich:contracts:v1:campaign",
  "x-semantic-validation": "See platform/src/lib/contracts.ts and the Rust kernel; schema alone does not establish valid identities, scores, or execution."
}
