{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "create": {
          "type": "string",
          "minLength": 2,
          "maxLength": 48,
          "pattern": "^[\\p{L}\\p{N} ._'’-]+$"
        }
      },
      "required": [
        "create"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "join": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        }
      },
      "required": [
        "join"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "leave": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "leave"
      ],
      "additionalProperties": false
    }
  ],
  "$id": "urn:voynich:contracts:v1:team-update",
  "x-semantic-validation": "See platform/src/lib/contracts.ts and the Rust kernel; schema alone does not establish valid identities, scores, or execution."
}
