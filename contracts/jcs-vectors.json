{
  "_comment": "RFC 8785 (JCS) conformance vectors shared by the Rust kernel and the Python contract tooling. `numbers` give IEEE-754 binary64 bit patterns (big-endian hex) and the expected ES6 string. Derived from the ES6 Number.prototype.toString rules and the RFC 8785 section 3.2.3 example; confirm against the reference implementation (cyberphone/json-canonicalization) from an environment that can reach it.",
  "vectors": [
    {
      "name": "rfc8785-section-3.2.3-example",
      "input": {
        "numbers": [
          333333333.3333333,
          1e+30,
          4.5,
          0.002,
          1e-27
        ],
        "string": "\u20ac$\u000f\nA'B\"\\\\\"/",
        "literals": [
          null,
          true,
          false
        ]
      },
      "expected": "{\"literals\":[null,true,false],\"numbers\":[333333333.3333333,1e+30,4.5,0.002,1e-27],\"string\":\"\u20ac$\\u000f\\nA'B\\\"\\\\\\\\\\\"/\"}"
    },
    {
      "name": "utf16-key-order",
      "input": {
        "\ud834\udd1e": 1,
        "\uff5e": 2,
        "a": 3
      },
      "expected": "{\"a\":3,\"\ud834\udd1e\":1,\"\uff5e\":2}",
      "note": "UTF-16 code-unit order: U+1D11E is D834 DD1E and sorts before U+FF5E; UTF-8 byte order would put U+FF5E first."
    },
    {
      "name": "nested-and-negative-zero",
      "input": {
        "b": {
          "y": [
            1,
            2
          ],
          "x": -0.0
        },
        "a": "\t\u0001"
      },
      "expected": "{\"a\":\"\\t\\u0001\",\"b\":{\"x\":0,\"y\":[1,2]}}"
    },
    {
      "name": "work-unit-like",
      "input": {
        "schema_version": "vah-work-unit-0.2",
        "seed_start": 0,
        "seed_count": 4,
        "params": {
          "p_modify": 0.85,
          "window_lines": 4,
          "alphabet": "ocheydaiklrstqnmpfg"
        },
        "family": "selfcite",
        "resources_digest": null
      },
      "expected": "{\"family\":\"selfcite\",\"params\":{\"alphabet\":\"ocheydaiklrstqnmpfg\",\"p_modify\":0.85,\"window_lines\":4},\"resources_digest\":null,\"schema_version\":\"vah-work-unit-0.2\",\"seed_count\":4,\"seed_start\":0}"
    },
    {
      "name": "empty-containers",
      "input": {
        "z": [],
        "a": {},
        "m": ""
      },
      "expected": "{\"a\":{},\"m\":\"\",\"z\":[]}"
    }
  ],
