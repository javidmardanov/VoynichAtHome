# Real credentials belong in ignored .dev.vars locally or hosted secrets.
AUTH_SECRET=
AUTH_BASE_URL=http://localhost:5173
# Enable only on the trusted HTTPS Sites origin described in docs/OWNER-SETUP.md.
SITES_AUTH_ENABLED=false
# Reviewed GitHub OIDC identity JSON; leave unset until hosted scheduling is configured.
GITHUB_MAINTENANCE_IDENTITY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OWNER_USER_ID=
DEPLOYMENT_STAGE=development
ASSIGNMENTS_ENABLED=false
