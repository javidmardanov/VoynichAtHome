{
  "name": "@voynich/platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/sync-hosting.mjs",
    "prebuild": "node scripts/sync-hosting.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "package:worker": "node scripts/package-worker.mjs",
    "kernel:package": "node scripts/package-kernel.mjs",
    "preview": "wrangler dev --config wrangler.deploy.jsonc --port 8787 --ip 127.0.0.1",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:browser": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:local": "wrangler d1 migrations apply DB --local"
  },
  "dependencies": {
    "better-auth": "1.7.2",
    "@better-auth/drizzle-adapter": "1.7.2",
    "drizzle-orm": "0.45.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@sveltejs/adapter-cloudflare": "7.2.9",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "svelte": "5.57.0",
    "svelte-check": "4.7.6",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "@playwright/test": "1.63.0",
    "@cloudflare/workers-types": "5.20260905.1",
    "wrangler": "4.129.0",
    "drizzle-kit": "0.31.10",
    "@types/node": "^22.19.0",
    "miniflare": "5.20260903.0-alpha",
    "better-call": "1.4.0",
    "@openai/sites-vite-plugin": "0.2.0"
  }
}
